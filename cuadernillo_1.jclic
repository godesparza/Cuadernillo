 <sequence>
  <item id="start" name="Dialogo en equipo" />
 </sequence>
 <activities>
  <activity class="@associations.SimpleAssociation" name="Dialogo en equipo" code="">
   <description />
   <messages>
    <cell border="true" type="initial">
     <style borderStroke="0.0" markerStroke="2.7">
      <font family="Arial" size="22" />
      <gradient source="0xCC6600" dest="0xFFFF66" angle="250" />
     </style>
     <p>Relaciona las imagenes con los textos correctos</p>
    </cell>
    <cell type="final">
     <style borderStroke="0.7" markerStroke="4.1">
      <gradient source="0xCC6600" dest="0xFFFF66" angle="126" />
     </style>
     <p>FELICIDADES</p>
    </cell>
   </messages>
   <settings margin="8" report="true" reportActions="false">
    <container bgColor="0xFFCCCC">
     <gradient source="0x000000" dest="0xFFFFFF" angle="0" />
     <counters time="true" actions="true" score="true" />
    </container>
    <window bgColor="0xFFCCCC" border="true" />
   </settings>
   <cells rows="4" cols="1" cellWidth="179.0" cellHeight="150.0" border="true" id="primary">
    <style />
    <shaper class="@Rectangular" cols="1" rows="4" />
    <cell image="Mirlo-resized.jpg">
     <style borderStroke="0.7" markerStroke="4.1">
      <color background="0xFFFFFF" alternative="0xFFFFFF" />
     </style>
    </cell>
    <cell border="true" image="Captura de pantalla 2026-10-05 093711.png">
     <style borderStroke="0.7" markerStroke="4.1">
      <color background="0xFFFFFF" alternative="0xFFFFFF" />
     </style>
    </cell>
    <cell border="true" image="sapo-resized.jpg">
     <style borderStroke="0.7" markerStroke="4.1">
      <color background="0xFFFFFF" alternative="0xFFFFFF" />
     </style>
    </cell>
    <cell image="Captura de pantalla 2026-10-05 092339.png">
     <style borderStroke="0.7" markerStroke="4.1">
      <color background="0xFFFFFF" alternative="0xFFFFFF" />
     </style>
    </cell>
   </cells>
   <cells rows="4" cols="1" cellWidth="170.0" cellHeight="149.0" border="true" id="secondary">
    <style />
    <shaper class="@Rectangular" cols="1" rows="4" />
    <cell>
     <style borderStroke="0.7" markerStroke="4.1">
      <color background="0xFFFFFF" alternative="0xFFFFFF" />
     </style>
     <p>Mirlo</p>
    </cell>
    <cell>
     <style borderStroke="0.7" markerStroke="4.1">
      <color background="0xFFFFFF" alternative="0xFFFFFF" />
     </style>
     <p>Lobo</p>
    </cell>
    <cell>
     <style borderStroke="0.7" markerStroke="4.1">
      <color background="0xFFFFFF" alternative="0xFFFFFF" />
     </style>
     <p>Sapo</p>
    </cell>
    <cell>
     <style borderStroke="0.7" markerStroke="4.1">
      <color background="0xFFFFFF" alternative="0xFFFFFF" />
     </style>
     <p>Sapo,Mirlo y Lobo, Amigos </p>
    </cell>
   </cells>
   <scramble times="31" primary="true" secondary="true" />
   <layout position="AB" />
  </activity>
 </activities>
